{
  "manifest_version": 3,
  "name": "Lockdown",
  "version": "0.1.0",
  "description": "Fill and save sign-ins from the Lockdown app on this computer.",
  "permissions": ["nativeMessaging", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["passkeys.js"],
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["webauthn.js"],
      "world": "MAIN",
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Lockdown", "default_popup": "popup.html" },
  "commands": {
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Fill the best login for this page (press again for the next one)"
    }
  },
  "web_accessible_resources": [{ "resources": ["frame.html", "frame.js", "tokens.css", "ui.css"], "matches": ["http://*/*", "https://*/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "chromium": {
    "key": "",
    "minimum_chrome_version": "121",
    "background": { "service_worker": "background.js", "type": "module" },
    "extra_permissions": ["webRequestAuthProvider"]
  },
  "firefox": {
    "browser_specific_settings": { "gecko": { "id": "lockdown@snds.design", "strict_min_version": "128.0" } },
    "background": { "scripts": ["background.js"], "type": "module" },
    "extra_permissions": ["webRequestBlocking"]
  }
}
