{
  "name": "lockdown-design-capture",
  "private": true,
  "version": "0.1.0",
  "description": "The design-review harness: the real desktop, web vault and extension UI over one invented fixture set, a screen capture with axe, and a static review build",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "review:build": "node scripts/review-build.ts",
    "capture": "node scripts/capture.ts",
    "shots": "vite build && node scripts/capture.ts --sizes 1440x900,390x844 --strict --out test-results/shots",
    "engine:check": "node scripts/engine-check.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@unicron/tokens": "file:../../vendor/unicron/unicron-tokens-1.0.0-pre.2.tgz",
    "@unicron/ui": "file:../../vendor/unicron/unicron-ui-1.0.0-pre.2.tgz",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.3.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
